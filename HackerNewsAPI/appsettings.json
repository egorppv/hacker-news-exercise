{
  "Hosting": {
    "Kestrel": {
      "HttpPort": 5000
    }
  },
  "BackgroundFetcher": {
    "ApiBaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "PollIntervalTimeSpan": "00:01:00",
    "RequestTimeoutSeconds": 10,
    "RetryCount": 3,
    "ParallelDownloadsNumber": 10,
    "CacheExpirationTimeSpan": "24:00:00"
  }
}
